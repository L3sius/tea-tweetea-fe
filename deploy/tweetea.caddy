# tea-osrs.com: this site on the clan's droplet (docs/deploy.md), imported by the droplet's
# /etc/caddy/Caddyfile. deploy/setup-droplet.sh installs it as /etc/caddy/tweetea.caddy; rerun it
# after a change here.
# - /srv/tweetea/site is a link to the live release, which each deploy moves.
# - Vite names the built code and styles after their content (/assets/*), so they are cached for a
#   year. Pages, sounds, voice lines and terrain are revalidated on every visit, so a deploy shows at
#   once.
# - Pages like /stats and /admin are routes of the app, not files: they get index.html.
tea-osrs.com {
	root * /srv/tweetea/site
	encode zstd gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

www.tea-osrs.com {
	redir https://tea-osrs.com{uri} permanent
}
